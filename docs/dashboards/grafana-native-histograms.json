{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus (or Prometheus-compatible) datasource scraping token-auth-proxy's /metrics.",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "token-auth-proxy (native histograms)",
  "description": "Same panels as grafana.json, rewritten for a scrape config that converts token-auth-proxy's classic histograms to native histograms at scrape time (e.g. Prometheus's convertClassicHistogramsToNHCB, or a remote-write path that only forwards native histogram samples). Use this instead of grafana.json when the classic *_bucket/_count/_sum series read as empty and only the bare histogram metric name resolves.",
  "uid": "token-auth-proxy-nh",
  "tags": ["token-auth-proxy", "native-histograms"],
  "timezone": "",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "links": [],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "current": {},
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "label": "Job",
        "query": "label_values(target_info, job)",
        "definition": "label_values(target_info, job)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Inbound request rate, by status code",
      "description": "Every request that reaches \"/\" (otelhttp records this for both allowed and authn-rejected requests, since it wraps requireAuth). A rejection shows up here as a 401/403, same as any other non-2xx.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (http_response_status_code) (histogram_count(rate(http_server_request_duration_seconds{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Outbound request rate to backend, by status code",
      "description": "Requests the proxy actually forwarded to its configured target, and how the backend responded.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (http_response_status_code) (histogram_count(rate(http_client_request_duration_seconds{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Inbound request duration",
      "description": "Time otelhttp's server middleware measures for \"/\", including whatever requireAuth itself takes (credential/JWKS checks) before it even reaches the backend.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.5, sum(rate(http_server_request_duration_seconds{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Outbound (backend) request duration",
      "description": "Time spent waiting on the configured target. Compare against the inbound panel: a gap between the two is time requireAuth/the proxy itself is adding.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.5, sum(rate(http_client_request_duration_seconds{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_client_request_duration_seconds{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum(rate(http_client_request_duration_seconds{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Authn rejections",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rejection rate, by reason",
      "description": "Why requests are getting a 401/403 - see the observability guide for the full list of reason values. authn_rejections_total is a plain counter, not a histogram, so this query is identical to grafana.json's.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (reason) (rate(authn_rejections_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "JWKS / IdP-metadata outage",
      "description": "keys_unavailable or saml_metadata_unavailable rejections mean the proxy's own configured JWKS/IdP-metadata endpoint is unreachable - operator-actionable, unlike the rest of the rejection reasons.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 19, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(authn_rejections_total{job=\"$job\", reason=~\"keys_unavailable|saml_metadata_unavailable\"}[5m]))",
          "legendFormat": "outage rejections/s"
        }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Rejections in range, by reason",
      "description": "Total count of each rejection reason over the dashboard's selected time range.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 18, "y": 19, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (reason) (increase(authn_rejections_total{job=\"$job\"}[$__range]))",
          "legendFormat": "{{reason}}",
          "instant": true
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "Body size",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Inbound request/response body size (p95)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_body_size_bytes{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "request"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_response_body_size_bytes{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "response"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Outbound (backend) request body size (p95)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_client_request_body_size_bytes{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "request"
        }
      ]
    }
  ]
}
